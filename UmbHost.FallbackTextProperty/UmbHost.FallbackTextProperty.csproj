<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <RootNamespace>UmbHost.FallbackTextProperty</RootNamespace>
    <!-- Razor Class Library: serve wwwroot/App_Plugins/** at the site root (/App_Plugins/**)
         rather than the default /_content/{pkg}/, so Umbraco's AppPluginsPackageManifestReader
         (which scans the App_Plugins path of the WebRoot+ContentRoot composite provider) finds
         the umbraco-package.json. Same convention as Umbraco.Community.BlockPreview. -->
    <StaticWebAssetBasePath>/</StaticWebAssetBasePath>
  </PropertyGroup>

  <!-- NuGet package metadata -->
  <PropertyGroup>
    <PackageId>UmbHost.FallbackTextProperty</PackageId>
    <Version>17.0.0</Version>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/wholething/wholething-fallback-text-property</PackageProjectUrl>
    <PackageTags>Umbraco</PackageTags>
    <Authors>Harry Gordon and Wholething (Dean Leigh and Ault Nathanielsz)</Authors>
    <Description>FallbackTextProperty is an Umbraco property editor that defines a fallback/default value that users can optionally override.</Description>
    <PackageReleaseNotes>
      ### Version 17.0.0
      - Rebuilt for Umbraco 17 / .NET 10: new backoffice (Lit) property editor, published content cache APIs, backoffice-authorized preview endpoint.
    </PackageReleaseNotes>
  </PropertyGroup>

  <ItemGroup>
    <!-- v14+ discontinued Umbraco.Cms.Web.BackOffice; extension libraries reference the
         granular web packages. Web.Website brings Core + value-converter/composer APIs;
         Web.Common brings AuthorizationPolicies.BackOfficeAccess for the preview endpoint. -->
    <PackageReference Include="Umbraco.Cms.Web.Website" Version="17.6.2" />
    <PackageReference Include="Umbraco.Cms.Web.Common" Version="17.6.2" />
    <PackageReference Include="Handlebars.Net" Version="2.1.6" />
  </ItemGroup>

  <ItemGroup>
    <!-- Client sources build into wwwroot/App_Plugins/FallbackTextstring/dist; don't treat as compile inputs. -->
    <None Remove="Client\**" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="UmbHost.FallbackTextProperty.Test" />
  </ItemGroup>

  <!-- Build the Vite/Lit client bundle into wwwroot/App_Plugins/FallbackTextstring/dist.
       Runs before static web assets are collected so the bundle is packaged/served.
       Skipped on incremental Debug builds when the bundle already exists. -->
  <Target Name="BuildClient" BeforeTargets="BeforeBuild;ResolveStaticWebAssetsInputs"
          Condition="!Exists('wwwroot\App_Plugins\FallbackTextstring\dist\fallback.js') Or '$(Configuration)' == 'Release'">
    <Exec Command="npm ci" WorkingDirectory="Client" />
    <Exec Command="npm run build" WorkingDirectory="Client" />
  </Target>

</Project>
