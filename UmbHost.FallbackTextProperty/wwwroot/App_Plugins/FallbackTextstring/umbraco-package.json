{
  "$schema": "../../umbraco-package-schema.json",
  "name": "UmbHost.FallbackTextProperty",
  "version": "17.0.0",
  "extensions": [
    {
      "type": "bundle",
      "alias": "UmbHost.Bundle.FallbackText",
      "name": "Fallback Text Bundle",
      "js": "/App_Plugins/FallbackTextstring/dist/fallback.js"
    },

    {
      "type": "propertyEditorSchema",
      "name": "Fallback Textstring",
      "alias": "FallbackTextstring",
      "meta": {
        "defaultPropertyEditorUiAlias": "UmbHost.PropertyEditorUi.FallbackTextstring"
      }
    },
    {
      "type": "propertyEditorSchema",
      "name": "Fallback Textarea",
      "alias": "FallbackTextarea",
      "meta": {
        "defaultPropertyEditorUiAlias": "UmbHost.PropertyEditorUi.FallbackTextarea"
      }
    },

    {
      "type": "propertyEditorUi",
      "alias": "UmbHost.PropertyEditorUi.FallbackTextstring",
      "name": "Textstring with Fallback",
      "element": "/App_Plugins/FallbackTextstring/dist/fallback.js",
      "elementName": "fallback-textstring-ui",
      "meta": {
        "label": "Textstring with Fallback",
        "icon": "icon-edit",
        "group": "common",
        "propertyEditorSchemaAlias": "FallbackTextstring",
        "settings": {
          "properties": [
            { "alias": "fallbackTemplate", "label": "Fallback Template", "description": "Mustache template used when the value is blank. Refer to node properties (e.g. {{pageTitle}}) or other nodes by id (e.g. {{1234:heroTitle}}).", "propertyEditorUiAlias": "Umb.PropertyEditorUi.TextBox" },
            { "alias": "maxChars", "label": "Maximum allowed characters", "propertyEditorUiAlias": "Umb.PropertyEditorUi.Integer" },
            { "alias": "allowNone", "label": "Allow none", "description": "Add an explicit option for \"None\" which sets the field to empty.", "propertyEditorUiAlias": "Umb.PropertyEditorUi.Toggle" }
          ]
        }
      }
    },
    {
      "type": "propertyEditorUi",
      "alias": "UmbHost.PropertyEditorUi.FallbackTextarea",
      "name": "Textarea with Fallback",
      "element": "/App_Plugins/FallbackTextstring/dist/fallback.js",
      "elementName": "fallback-textarea-ui",
      "meta": {
        "label": "Textarea with Fallback",
        "icon": "icon-edit",
        "group": "common",
        "propertyEditorSchemaAlias": "FallbackTextarea",
        "settings": {
          "properties": [
            { "alias": "fallbackTemplate", "label": "Fallback Template", "propertyEditorUiAlias": "Umb.PropertyEditorUi.TextArea" },
            { "alias": "maxChars", "label": "Maximum allowed characters", "propertyEditorUiAlias": "Umb.PropertyEditorUi.Integer" },
            { "alias": "rows", "label": "Number of rows", "propertyEditorUiAlias": "Umb.PropertyEditorUi.Integer" },
            { "alias": "allowNone", "label": "Allow none", "propertyEditorUiAlias": "Umb.PropertyEditorUi.Toggle" }
          ]
        }
      }
    }
  ]
}
